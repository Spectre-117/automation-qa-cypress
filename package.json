{
  "name": "automation-qa-cypress",
  "version": "1.0.0",
  "description": "cypress trainig",
  "homepage": "https://github.com/Spectre-117/automation-qa-cypress#readme",
  "bugs": {
    "url": "https://github.com/Spectre-117/automation-qa-cypress/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spectre-117/automation-qa-cypress.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "npx cypress run",
    "open": "npx cypress open",
    "merge-reports": "npx mochawesome-merge \"cypress/results/*.json\" > mochawesome.json",
    "generate-report": "npx marge mochawesome.json",
    "report": "npm run merge-reports && npm run generate-report",
    "cypress:user1": "cypress open --config-file cypress.config.user1.js",
    "cypress:user2": "cypress open --config-file cypress.config.user2.js",
    "cypress:run:user1": "cypress run --config-file cypress.config.user1.js",
    "cypress:run:user2": "cypress run --config-file cypress.config.user2.js"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0"
  },
  "devDependencies": {
    "cypress": "^15.6.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.0",
    "mochawesome-report-generator": "^6.3.2"
  }
}
